{
  "version": 3,
  "configurePresets": [
    {
      "name": "debug-nodrm",
      "displayName": "Debug (no DRM)",
      "binaryDir": "${sourceDir}/cmake-build-debug-nodrm",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "UNTETERED_DRM": "OFF" }
    },
    {
      "name": "debug-drm",
      "displayName": "Debug (DRM)",
      "binaryDir": "${sourceDir}/cmake-build-debug-drm",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "UNTETERED_DRM": "ON" }
    },
    {
      "name": "release",
      "displayName": "Release",
      "binaryDir": "${sourceDir}/cmake-build-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "UNTETERED_DRM": "ON" }
    }
  ]
}